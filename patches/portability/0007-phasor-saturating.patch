+        // arm_f2s32 and arm_f2u32 (shim/prelude.h) convert as the module.
+        return static_cast<int64_t>(arm_f2s32(i)) * kOne
+             + static_cast<int64_t>(arm_f2u32(frac * 4294967296.f)); // 2^32, i.e. uint32_t max
     }
 
     int64_t _v;
