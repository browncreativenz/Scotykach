+// turns inf into 0xFFFFFFFF and NaN into 0. On x86-64, GCC and Clang each
+// give other values, which take the other branch. arm_f2u32
+// (shim/prelude.h) converts as the module does.
 
 namespace spotykach {
 
@@ -32,7 +37,7 @@ inline static void skip_write_head_fwd(SkipRequest r)
     /* overtaking */
     if (r.inc > 1.f) {
         if (wh < rh) wh += r.rs;
-        auto ws = static_cast<size_t>((wh - rh) / (r.inc - 1.f));
+        auto ws = static_cast<size_t>(arm_f2u32((wh - rh) / (r.inc - 1.f)));
         if (ws >= kMinimumWindowSize) {
             *r.ws = std::min(ws, kDefaultWindowSize);
         }
@@ -49,7 +54,7 @@ inline static void skip_write_head_fwd(SkipRequest r)
     /* lagging */
     else {
         if (wh > rh) wh -= r.rs;
-        auto ws = static_cast<size_t>((rh - wh) / (1.f - r.inc));
+        auto ws = static_cast<size_t>(arm_f2u32((rh - wh) / (1.f - r.inc)));
